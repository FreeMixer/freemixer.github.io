[freemixer]
name=FreeMixer
baseurl=https://www.openmixer.org/rpm/fedora/$releasever/$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://www.openmixer.org/rpm/RPM-GPG-KEY-freemixer

[freemixer-noarch]
name=FreeMixer (noarch)
baseurl=https://www.openmixer.org/rpm/fedora/$releasever/noarch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://www.openmixer.org/rpm/RPM-GPG-KEY-freemixer

