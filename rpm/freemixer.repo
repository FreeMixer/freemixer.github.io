[freemixer]
name=FreeMixer
baseurl=https://freemixer.github.io/rpm/fedora/$releasever/$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://freemixer.github.io/rpm/RPM-GPG-KEY-freemixer

[freemixer-noarch]
name=FreeMixer (noarch)
baseurl=https://freemixer.github.io/rpm/fedora/$releasever/noarch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://freemixer.github.io/rpm/RPM-GPG-KEY-freemixer
